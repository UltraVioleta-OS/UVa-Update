#!/bin/sh
set -e
THEME=/usr/share/plymouth/themes/uvso/uvso.plymouth
case "$1" in
  configure)
    # Mecanismo 1: alternativa de Debian (--set la fija aunque estuviera en manual)
    update-alternatives --install /usr/share/plymouth/themes/default.plymouth \
      default.plymouth "$THEME" 200
    update-alternatives --set default.plymouth "$THEME"
    # Mecanismo 2: herramienta oficial de Plymouth (escribe Theme= en plymouthd.conf)
    if command -v plymouth-set-default-theme >/dev/null 2>&1; then
      plymouth-set-default-theme uvso || true
    fi
    if command -v update-initramfs >/dev/null 2>&1; then
      update-initramfs -u -k all || true
    fi
    if command -v update-grub >/dev/null 2>&1; then
      update-grub || true
    fi
    ;;
esac
exit 0
